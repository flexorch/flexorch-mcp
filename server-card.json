{
  "serverInfo": {
    "name": "flexorch-mcp",
    "version": "0.2.4"
  },
  "authentication": {
    "required": true,
    "schemes": ["apiKey"]
  },
  "tools": [
    {
      "name": "document.process",
      "title": "Process Document",
      "description": "Submit a document for processing — Step 1 of 5. Returns job_id immediately; poll job.status until completed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "file_url": {"type": "string", "description": "Publicly accessible URL of the document (http/https, max 50 MB)"},
          "mask_pii": {"type": "boolean", "default": true, "description": "Replace detected PII with [MASKED_TYPE] placeholders"},
          "document_type": {"type": "string", "default": "auto", "description": "Classification hint: invoice, expense_report, purchase_order, sales_proposal, bank_statement, payroll, or auto"}
        },
        "required": ["file_url"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "job_id": {"type": "integer"},
          "status": {"type": "string"},
          "poll_hint": {"type": "string"},
          "isError": {"type": "boolean"},
          "error": {"type": "string"}
        }
      },
      "annotations": {
        "title": "Process Document",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "job.status",
      "title": "Get Job Status",
      "description": "Poll a job until it finishes — Step 2. Call every 3-5s until status is completed or failed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "job_id": {"type": "integer", "description": "Job ID returned by document.process or dataset.build"}
        },
        "required": ["job_id"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "job_id": {"type": "integer"},
          "status": {"type": "string"},
          "execution_id": {"type": "integer"},
          "document_id": {"type": "integer", "description": "ID of the source document — pass to document.reprocess to re-run the pipeline on it"},
          "dataset_id": {"type": "integer"},
          "dataset_name": {"type": "string"},
          "row_count": {"type": "integer"},
          "quality_grade": {"type": "string"},
          "quality_score": {"type": "number"},
          "pii_found": {"type": "boolean"},
          "pii_masked": {"type": "boolean"},
          "pii_count": {"type": "integer"},
          "pii_type_summary": {"type": "object", "additionalProperties": {"type": "integer"}, "description": "Count of each PII type found, e.g. {\"email\": 2, \"national_id_tr\": 1}"},
          "has_dataset": {"type": "boolean"},
          "degraded": {"type": "boolean", "description": "True when the underlying execution completed but structured extraction found no table/schema in the document — quality/PII results are still valid, but build_dataset() will not apply"},
          "stage": {"type": "string"},
          "reason": {"type": "string"},
          "poll_hint": {"type": "string"},
          "isError": {"type": "boolean"},
          "error": {"type": "string"}
        }
      },
      "annotations": {
        "title": "Get Job Status",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "job.result",
      "title": "Get Extraction Result",
      "description": "Read structured fields extracted from a completed document — Step 3.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "execution_id": {"type": "integer", "description": "Execution ID from a completed data_process job"}
        },
        "required": ["execution_id"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "execution_id": {"type": "integer"},
          "document_id": {"type": "integer", "description": "ID of the source document — pass to document.reprocess to re-run the pipeline on it"},
          "document_type": {"type": "string"},
          "detected_language": {"type": "string"},
          "quality": {"type": "object"},
          "privacy": {"type": "object"},
          "row_count": {"type": "integer"},
          "columns": {"type": "array", "items": {"type": "string"}},
          "degraded": {"type": "boolean", "description": "True when structured extraction found no table/schema in this document — quality/privacy above are still valid"},
          "fields": {"type": "array"},
          "fields_hint": {"type": "string"},
          "has_more": {"type": "boolean"},
          "has_more_hint": {"type": "string"},
          "isError": {"type": "boolean"},
          "error": {"type": "string"}
        }
      },
      "annotations": {
        "title": "Get Extraction Result",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "dataset.build",
      "title": "Build Dataset",
      "description": "Package extracted records into a dataset for export — Step 4. Returns job_id; poll job.status until completed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "execution_id": {"type": "integer", "description": "Execution ID from a completed data_process job"},
          "name": {"type": "string", "default": "", "description": "Dataset name (auto-generated if omitted)"},
          "description": {"type": "string", "default": "", "description": "Optional description"}
        },
        "required": ["execution_id"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "job_id": {"type": "integer"},
          "status": {"type": "string"},
          "poll_hint": {"type": "string"},
          "isError": {"type": "boolean"},
          "error": {"type": "string"}
        }
      },
      "annotations": {
        "title": "Build Dataset",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "dataset.search",
      "title": "Search Documents",
      "description": "Search across all indexed FlexOrch datasets by keyword or semantic meaning.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "description": "Search query, max 1000 characters"},
          "top_k": {"type": "integer", "default": 5, "description": "Number of results, max 50"},
          "mode": {"type": "string", "default": "auto", "description": "Search strategy: auto, structured, semantic, hybrid"},
          "document_type": {"type": "string", "default": "", "description": "Filter by document type"},
          "language": {"type": "string", "default": "", "description": "Filter by ISO 639-1 language code"},
          "quality_grade": {"type": "string", "default": "", "description": "Filter by quality grade: A, B, C, or D"}
        },
        "required": ["query"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "results": {"type": "array"},
          "total_results": {"type": "integer"},
          "mode": {"type": "string"},
          "query": {"type": "string"},
          "isError": {"type": "boolean"},
          "error": {"type": "string"}
        }
      },
      "annotations": {
        "title": "Search Documents",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "dataset.export",
      "title": "Export Dataset",
      "description": "Download all records from a built dataset as text — Step 5, final step.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dataset_id": {"type": "integer", "description": "Dataset ID from completed build job"},
          "format": {"type": "string", "default": "jsonl", "description": "Export format: jsonl, csv, json, md, xml, rag"}
        },
        "required": ["dataset_id"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "dataset_id": {"type": "integer"},
          "format": {"type": "string"},
          "filename": {"type": "string"},
          "content": {"type": "string"},
          "byte_count": {"type": "integer"},
          "isError": {"type": "boolean"},
          "error": {"type": "string"}
        }
      },
      "annotations": {
        "title": "Export Dataset",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "dataset.index",
      "title": "Index Dataset for RAG",
      "description": "Trigger semantic indexing for a dataset (Pro+ plan required). Must be called before dataset.chunks. Indexing is idempotent and typically completes in 10–60 seconds.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dataset_id": {"type": "integer", "description": "ID of the built dataset to index (from job.status after dataset.build)"}
        },
        "required": ["dataset_id"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "dataset_id": {"type": "integer"},
          "status": {"type": "string"},
          "message": {"type": "string"},
          "index_hint": {"type": "string"},
          "isError": {"type": "boolean"},
          "error": {"type": "string"}
        }
      },
      "annotations": {
        "title": "Index Dataset for RAG",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "dataset.chunks",
      "title": "List RAG Chunks",
      "description": "Retrieve LangChain/LlamaIndex-ready text chunks from an indexed dataset (Pro+ plan required). Dataset must be indexed first via dataset.index.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dataset_id": {"type": "integer", "description": "ID of the indexed dataset"},
          "min_quality": {"type": "string", "default": "B", "description": "Minimum quality grade to include: A, B, C, or D. B returns A and B grade chunks."},
          "pii_masked_only": {"type": "boolean", "default": false, "description": "When true, return only chunks where PII was masked"},
          "page": {"type": "integer", "default": 1, "description": "Page number, 1-indexed"},
          "page_size": {"type": "integer", "default": 20, "description": "Chunks per page, max 100"}
        },
        "required": ["dataset_id"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "dataset_id": {"type": "integer"},
          "chunks": {"type": "array"},
          "chunk_count": {"type": "integer"},
          "total": {"type": "integer"},
          "page": {"type": "integer"},
          "page_size": {"type": "integer"},
          "has_more": {"type": "boolean"},
          "isError": {"type": "boolean"},
          "error": {"type": "string"}
        }
      },
      "annotations": {
        "title": "List RAG Chunks",
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "document.reprocess",
      "title": "Reprocess Document",
      "description": "Re-queue an already-uploaded document through the pipeline — e.g. after a document_type_hint change, without re-uploading the file. Returns job_id; poll job.status the same way as after document.process. Only works for locally-stored files.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "document_id": {"type": "integer", "description": "ID of a previously processed document (from job.status or job.result)"},
          "pipeline_config": {"type": "object", "description": "Optional pipeline config overrides, e.g. {\"document_type_hint\": \"invoice\"}"}
        },
        "required": ["document_id"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "job_id": {"type": "integer"},
          "status": {"type": "string"},
          "poll_hint": {"type": "string"},
          "isError": {"type": "boolean"},
          "error": {"type": "string"}
        }
      },
      "annotations": {
        "title": "Reprocess Document",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    }
  ],
  "resources": [],
  "prompts": []
}
